/* =========================
   GLOBAL
========================= */

* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  min-height: 100%;
  margin: 0;
}

body {
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;

  color: #374151;
}

/* =========================
   LOGIN PAGE
========================= */

.login-page {
  width: 100%;
  min-height: 100vh;

  display: flex;

  background: linear-gradient(135deg, #f8fbfe 0%, #edf6fd 50%, #e2f1fc 100%);

  overflow: hidden;
}

/* =========================
   LEFT SIDE
========================= */

.login-visual {
  position: relative;

  width: 49%;
  min-height: 100vh;

  background:
    linear-gradient(180deg, rgba(35, 93, 135, 0.15), rgba(25, 82, 128, 0.65)),
    url("/login-bg.jpg");

  background-size: cover;
  background-position: center;

  border-radius: 0 28px 28px 0;

  overflow: hidden;
}

/* Μπλε overlay πάνω από την εικόνα */

.visual-overlay {
  position: absolute;
  inset: 0;

  background: linear-gradient(
    180deg,
    rgba(18, 67, 105, 0.05) 0%,
    rgba(20, 75, 120, 0.18) 40%,
    rgba(14, 65, 108, 0.72) 100%
  );
}

/* =========================
   LEFT TEXT
========================= */

.visual-content {
  position: absolute;
  inset: 0;

  z-index: 2;

  display: flex;
  align-items: flex-end;

  padding: 0 0 105px 30px;
}

.welcome-text {
  color: white;

  text-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
}

.welcome-text > div {
  font-size: 26px;
  font-weight: 300;

  margin-bottom: 5px;
}

.welcome-text h1 {
  margin: 0;

  font-size: 47px;
  line-height: 1;

  font-weight: 300;

  letter-spacing: 4px;
}

.welcome-text p {
  margin: 17px 0 0;

  font-size: 15px;
  line-height: 1.6;

  font-weight: 300;

  color: rgba(255, 255, 255, 0.85);
}

/* =========================
   VERSION
========================= */

.version {
  position: absolute;

  left: 30px;
  bottom: 13px;

  z-index: 3;

  color: rgba(255, 255, 255, 0.65);

  font-size: 9px;
  font-weight: 400;
}

/* =========================
   RIGHT PANEL
========================= */

.login-panel {
  position: relative;

  width: 51%;
  min-height: 100vh;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  padding: 40px;
}

/* =========================
   LANGUAGE
========================= */

.language-switch {
  position: absolute;

  top: 25px;
  right: 28px;

  display: flex;
  align-items: center;
  gap: 7px;

  font-size: 11px;
}

.language-switch button {
  border: none;
  background: transparent;

  padding: 0;

  color: #6687a4;

  font-size: 11px;

  cursor: pointer;
}

.language-switch button:hover {
  color: #2376bd;
}

.language-switch .language-active {
  color: #1e73b7;

  font-weight: 600;

  border-bottom: 2px solid #2376bd;

  padding-bottom: 3px;
}

.language-switch span {
  color: #a8b6c3;
}

/* =========================
   LOGIN CONTENT
========================= */

.login-content {
  width: min(490px, 100%);

  display: flex;
  flex-direction: column;
  align-items: center;
}

/* =========================
   BRAND
========================= */

.brand {
  display: flex;
  align-items: center;

  gap: 12px;

  margin-bottom: 17px;
}

.brand-icon {
  color: #2377c1;

  font-size: 29px;
  font-weight: 300;

  line-height: 1;
}

.brand-name {
  display: flex;
  align-items: center;

  gap: 9px;

  font-size: 27px;

  color: #303a46;
}

.brand-name strong {
  color: #2879c2;

  font-weight: 500;

  letter-spacing: 1px;
}

.brand-name span {
  font-weight: 300;

  letter-spacing: 1px;
}

/* =========================
   DESCRIPTION
========================= */

.login-description {
  margin: 0 0 27px;

  color: #7c8793;

  font-size: 16px;

  font-weight: 300;

  text-align: center;
}

/* =========================
   FORM
========================= */

.login-form {
  width: 100%;
}

/* =========================
   INPUTS
========================= */

.login-field {
  width: 100%;

  margin-bottom: 15px;
}

.login-field input {
  width: 100%;

  height: 45px;

  padding: 0 15px;

  border: 1px solid #cfd5db;

  border-radius: 6px;

  background: rgba(255, 255, 255, 0.94);

  color: #394452;

  font-size: 14px;

  outline: none;

  transition:
    border-color 0.2s,
    box-shadow 0.2s;
}

.login-field input::placeholder {
  color: #aeb5bd;
}

.login-field input:focus {
  border-color: #3d8bc9;

  box-shadow: 0 0 0 3px rgba(61, 139, 201, 0.1);
}

/* =========================
   FORGOT PASSWORD
========================= */

.forgot-password {
  display: flex;
  justify-content: flex-end;

  margin: 0 0 25px;
}

.forgot-password button {
  border: none;
  background: transparent;

  padding: 0;

  color: #2778bb;

  font-size: 11px;

  cursor: pointer;
}

.forgot-password button:hover {
  text-decoration: underline;
}

/* =========================
   ERROR
========================= */

.login-error {
  margin-bottom: 14px;
  padding: 10px 12px;

  border-radius: 5px;

  background: #fff0f0;

  color: #c0392b;

  font-size: 12px;

  text-align: center;
}

/* =========================
   LOGIN BUTTON
========================= */

.login-button {
  width: 100%;
  height: 43px;

  border: none;
  border-radius: 6px;

  background: #78addb;

  color: white;

  font-size: 14px;
  font-weight: 500;

  cursor: pointer;

  transition:
    background 0.2s,
    transform 0.1s;
}

.login-button:hover {
  background: #5f9dd1;
}

.login-button:active {
  transform: translateY(1px);
}

.login-button:disabled {
  opacity: 0.65;

  cursor: not-allowed;
}

/* =========================
   OFFLINE BUTTON
========================= */

.offline-button {
  width: 100%;
  height: 43px;

  margin-top: 11px;

  border: 2px solid #287bc1;
  border-radius: 6px;

  background: transparent;

  color: #2875b5;

  font-size: 14px;
  font-weight: 500;

  cursor: pointer;

  transition:
    background 0.2s,
    color 0.2s;
}

.offline-button:hover {
  background: rgba(40, 123, 193, 0.08);
}

/* =========================
   FOOTER
========================= */

.login-footer {
  position: absolute;

  bottom: 24px;

  color: #7c8793;

  font-size: 11px;

  text-align: center;
}

/* =========================
   TABLET
========================= */

@media (max-width: 900px) {
  .login-visual {
    width: 43%;
  }

  .login-panel {
    width: 57%;

    padding: 30px;
  }

  .welcome-text h1 {
    font-size: 38px;
  }

  .welcome-text > div {
    font-size: 21px;
  }

  .welcome-text p {
    font-size: 13px;
  }
}

/* =========================
   MOBILE
========================= */

@media (max-width: 700px) {
  .login-page {
    min-height: 100vh;
  }

  .login-visual {
    display: none;
  }

  .login-panel {
    width: 100%;
    min-height: 100vh;

    padding: 30px 25px;
  }

  .login-content {
    width: min(430px, 100%);
  }

  .brand-name {
    font-size: 25px;
  }

  .login-description {
    font-size: 14px;
  }

  .login-footer {
    bottom: 15px;
  }
}
